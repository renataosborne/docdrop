<div class="card mt-6" id="upload_link">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="text-lg font-semibold">Upload link</h2>
      <p class="text-sm text-slate-600">Send this private link to <%= document_request.client_name %>. They can upload without an account.</p>
    </div>
    <% case document_request.upload_link_status %>
    <% when :active %>
      <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700">Active until <%= l document_request.upload_expires_at.to_date, format: :long %></span>
    <% when :expired %>
      <span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700">Expired</span>
    <% else %>
      <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Off</span>
    <% end %>
  </div>

  <% if document_request.upload_link_active? %>
    <div class="mt-4 flex gap-2" data-controller="clipboard">
      <label for="upload_link_url" class="sr-only">Upload link</label>
      <input id="upload_link_url" type="text" readonly value="<%= upload_url(document_request.upload_token) %>"
             class="form-input mt-0 font-mono text-sm" data-clipboard-target="source" onclick="this.select()">
      <button type="button" class="btn-primary shrink-0" data-clipboard-target="button" data-action="clipboard#copy">Copy link</button>
    </div>
  <% end %>

  <div class="mt-4 flex flex-wrap gap-2 text-sm">
    <% if document_request.upload_link_active? %>
      <%= button_to "Turn off link", disable_document_request_upload_link_path(document_request), class: "btn-secondary py-1.5" %>
    <% else %>
      <%= button_to "Turn on link", enable_document_request_upload_link_path(document_request), class: "btn-primary py-1.5" %>
    <% end %>
    <%= button_to "Reset link", reset_document_request_upload_link_path(document_request), class: "btn-secondary py-1.5",
          form: { data: { turbo_confirm: "Create a new link? The current link will stop working." } } %>
  </div>
</div>

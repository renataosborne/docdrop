<% content_for :title, "#{@document_request.title} · DocDrop" %>

<div class="mx-auto max-w-3xl">
  <%= link_to "← Dashboard", root_path, class: "text-link text-sm" %>

  <div class="mt-2 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold"><%= @document_request.title %></h1>
      <p class="mt-1 text-slate-600">
        For <span class="font-medium text-ink"><%= @document_request.client_name %></span>
        · <%= mail_to @document_request.client_email, class: "text-link" %>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_document_request_path(@document_request), class: "btn-secondary" %>
      <%= button_to "Delete", @document_request, method: :delete, class: "btn-secondary text-red-700",
            form: { data: { turbo_confirm: "Delete this request and its checklist?" } } %>
    </div>
  </div>

  <div class="card mt-6">
    <%= render "document_requests/progress", document_request: @document_request %>

    <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-slate-500">Due date</dt>
        <dd class="font-medium <%= "text-red-700" if @document_request.overdue? %>"><%= @document_request.due_on ? l(@document_request.due_on, format: :long) : "No due date" %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Created</dt>
        <dd class="font-medium"><%= l @document_request.created_at.to_date, format: :long %></dd>
      </div>
    </dl>

    <% if @document_request.message.present? %>
      <div class="mt-5 rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-700">
        <p class="font-medium text-slate-500">Message to client</p>
        <%= simple_format @document_request.message, class: "mt-1" %>
      </div>
    <% end %>
  </div>

  <div class="card mt-6">
    <h2 class="text-lg font-semibold">Checklist</h2>
    <ul class="mt-2 divide-y divide-slate-100" id="checklist">
      <%= render partial: "checklist_items/checklist_item", collection: @document_request.checklist_items %>
    </ul>
  </div>
</div>

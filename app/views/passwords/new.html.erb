<% content_for :title, "Reset your password · DocDrop" %>

<div class="mx-auto w-full max-w-md">
  <div class="card">
    <h1 class="text-2xl font-bold">Forgot your password?</h1>
    <p class="mt-1 text-sm text-slate-600">We'll email you a link to choose a new one.</p>

    <%= form_with url: passwords_path, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :email_address, "Email", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "form-input" %>
      </div>

      <%= form.submit "Email reset instructions", class: "btn-primary w-full" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-600"><%= link_to "Back to sign in", new_session_path, class: "text-link" %></p>
  </div>
</div>

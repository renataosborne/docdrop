<% content_for :title, "Sign in · DocDrop" %>

<div class="mx-auto w-full max-w-md">
  <div class="card">
    <h1 class="text-2xl font-bold">Sign in</h1>
    <p class="mt-1 text-sm text-slate-600">Request, collect and track documents in one place.</p>

    <%= form_with url: session_path, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :email_address, "Email", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "form-input" %>
      </div>

      <div>
        <div class="flex items-baseline justify-between">
          <%= form.label :password, class: "form-label" %>
          <%= link_to "Forgot password?", new_password_path, class: "text-link text-sm" %>
        </div>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "form-input" %>
      </div>

      <%= form.submit "Sign in", class: "btn-primary w-full" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-600">
      New to DocDrop? <%= link_to "Create an account", new_registration_path, class: "text-link" %>
    </p>
  </div>

  <p class="mt-4 rounded-lg border border-dashed border-slate-300 px-4 py-3 text-center text-sm text-slate-600">
    Just looking around? Use the demo account:
    <span class="font-mono text-ink">demo@docdrop.test</span> / <span class="font-mono text-ink">docdrop-demo</span>
  </p>
</div>

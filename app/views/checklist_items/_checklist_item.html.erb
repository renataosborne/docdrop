<li id="<%= dom_id(checklist_item) %>" class="flex items-center justify-between gap-4 py-3">
  <div class="flex min-w-0 items-center gap-3">
    <span class="grid size-6 shrink-0 place-items-center rounded-full text-xs font-bold <%= checklist_item.received? ? "bg-brand-500 text-white" : "border-2 border-slate-300 text-transparent" %>" aria-hidden="true">✓</span>
    <div class="min-w-0">
      <p class="truncate font-medium <%= "text-slate-500 line-through decoration-slate-300" if checklist_item.received? %>"><%= checklist_item.name %></p>
      <p class="text-xs text-slate-500">
        <%= checklist_item.received? ? "Received #{time_ago_in_words(checklist_item.received_at)} ago" : "Waiting for client" %>
      </p>
    </div>
  </div>

  <% if checklist_item.received? %>
    <%= button_to "Mark as missing", document_request_checklist_item_path(checklist_item.document_request, checklist_item),
          method: :patch, params: { checklist_item: { status: "pending" } }, class: "btn-secondary shrink-0 py-1.5 text-xs",
          aria: { label: "Mark #{checklist_item.name} as missing" } %>
  <% else %>
    <%= button_to "Mark received", document_request_checklist_item_path(checklist_item.document_request, checklist_item),
          method: :patch, params: { checklist_item: { status: "received" } }, class: "btn-primary shrink-0 py-1.5 text-xs",
          aria: { label: "Mark #{checklist_item.name} as received" } %>
  <% end %>
</li>

<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "DocDrop" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="DocDrop">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-ink antialiased">
    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4">
        <%= link_to root_path, class: "text-lg font-bold tracking-tight" do %>
          Doc<span class="text-brand-600">Drop</span>
        <% end %>

        <% if authenticated? %>
          <div class="flex items-center gap-4 text-sm">
            <span class="hidden text-slate-600 sm:inline" id="current-user"><%= Current.user.name %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn-secondary py-1.5" %>
          </div>
        <% end %>
      </nav>
    </header>

    <main class="mx-auto max-w-5xl px-5 py-10 sm:py-16">
      <% flash.each do |type, message| %>
        <p id="<%= type %>" role="<%= type == "alert" ? "alert" : "status" %>"
           class="mb-6 rounded-lg px-4 py-3 text-sm font-medium <%= type == "alert" ? "bg-red-50 text-red-700" : "bg-brand-50 text-brand-700" %>">
          <%= message %>
        </p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>

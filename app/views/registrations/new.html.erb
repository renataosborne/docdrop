<% content_for :title, "Create an account · DocDrop" %>

<div class="mx-auto w-full max-w-md">
  <div class="card">
    <h1 class="text-2xl font-bold">Create an account</h1>
    <p class="mt-1 text-sm text-slate-600">Start requesting documents in a minute.</p>

    <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-5" do |form| %>
      <% if @user.errors.any? %>
        <div id="error_explanation" role="alert" class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">
          <p class="font-semibold">Please fix the following:</p>
          <ul class="mt-1 list-disc pl-5">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :name, class: "form-label" %>
        <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "form-input" %>
      </div>

      <div>
        <%= form.label :email_address, "Email", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autocomplete: "email", class: "form-input" %>
      </div>

      <div>
        <%= form.label :password, class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "form-input", aria: { describedby: "password-hint" } %>
        <p id="password-hint" class="mt-1 text-xs text-slate-500">At least 8 characters.</p>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirm password", class: "form-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "form-input" %>
      </div>

      <%= form.submit "Create account", class: "btn-primary w-full" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-600">
      Already have an account? <%= link_to "Sign in", new_session_path, class: "text-link" %>
    </p>
  </div>
</div>
